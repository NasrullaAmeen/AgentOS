{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "AgentOS run cost log",
  "type": "object",
  "required": ["timestamp", "agent", "task", "model", "tokens_in", "tokens_out", "wall_clock_sec"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 run start time"
    },
    "agent": {
      "type": "string",
      "description": "Agent name (e.g. github-research, analysis)"
    },
    "task": {
      "type": "string",
      "description": "User-facing task description"
    },
    "slug": {
      "type": "string",
      "description": "Research slug if applicable"
    },
    "model": {
      "type": "string",
      "description": "Model ID (e.g. claude-sonnet-4-20250514)"
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0,
      "description": "Input tokens consumed"
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0,
      "description": "Output tokens produced"
    },
    "wall_clock_sec": {
      "type": "number",
      "minimum": 0,
      "description": "End-to-end wall-clock seconds"
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of reruns needed"
    },
    "usd_estimate": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated cost in USD (optional, computed from pricing)"
    },
    "verdict": {
      "type": "string",
      "enum": ["ready-for-coding", "need-more-research", "answer-only"],
      "description": "Analysis verdict if applicable"
    }
  }
}
